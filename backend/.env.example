# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=email_automation_db

# Security
SECRET_KEY=change-me-to-a-long-random-secret-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Email Platform

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_BATCH_SIZE=50

# Frontend
FRONTEND_URL=http://localhost:5173

# Application
DEBUG=false
